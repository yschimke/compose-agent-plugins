{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/pr-watch-session-start.sh\" --harness=claude",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "startup|resume"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/pr-watch.py\" --harness=claude",
            "timeout": 30,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "asyncRewake": true,
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/pr-watch-rewake.sh\" --harness=claude",
            "timeout": 1800,
            "type": "command"
          }
        ]
      }
    ]
  }
}
