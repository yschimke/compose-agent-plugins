{
  "mcpServers": {
    "catalog": {
      "headers": {
        "X-Compose-Preview-Token": "${COMPOSE_PREVIEW_TOKEN:-}"
      },
      "serverUrl": "https://preview.coo.ee/mcp",
      "tools": {
        "catalog_render_preview": {
          "eager": true
        }
      }
    },
    "cli": {
      "args": [
        "mcp",
        "serve"
      ],
      "command": "compose-preview",
      "tools": {
        "render_preview": {
          "eager": true
        },
        "simulator_open": {
          "eager": true
        }
      }
    }
  }
}
