{
  "mcpServers": {
    "compose-preview-catalog": {
      "headers": {
        "X-Compose-Preview-Token": "${user_config.compose_preview_token}"
      },
      "type": "http",
      "url": "https://preview.coo.ee/mcp"
    },
    "compose-preview-mcp": {
      "args": [
        "-c",
        "PATH=\"$PATH:$HOME/.local/bin\"; export PATH; if command -v node >/dev/null 2>&1 && [ -f \"$1\" ]; then exec node \"$@\"; fi; shift; exec \"$@\"",
        "compose-preview-mcp-launcher",
        "${CLAUDE_PLUGIN_ROOT}/scripts/mcp-proxy.mjs",
        "compose-preview",
        "mcp",
        "serve"
      ],
      "command": "sh"
    }
  }
}
