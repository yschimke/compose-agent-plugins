{
  "mcpServers": {
    "compose-preview-catalog": {
      "headers": {
        "X-Compose-Preview-Token": "${user_config.compose_preview_token}"
      },
      "type": "http",
      "url": "https://preview.coo.ee/mcp"
    },
    "compose-preview-mcp": {
      "args": [
        "-c",
        "PATH=\"$PATH:$HOME/.local/bin\"; export PATH; exec \"$0\" \"$@\"",
        "compose-preview",
        "mcp",
        "serve"
      ],
      "command": "sh"
    }
  }
}
