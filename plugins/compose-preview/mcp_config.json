{
  "mcpServers": {
    "catalog": {
      "headers": {
        "X-Compose-Preview-Token": "${COMPOSE_PREVIEW_TOKEN:-}"
      },
      "serverUrl": "https://preview.coo.ee/mcp",
      "tools": {
        "catalog_render_preview": {
          "eager": true
        }
      }
    },
    "cli": {
      "args": [
        "-c",
        "PATH=\"$PATH:$HOME/.local/bin\"; export PATH; if command -v node >/dev/null 2>&1 && [ -f \"$1\" ]; then exec node \"$@\"; fi; shift; exec \"$@\"",
        "compose-preview-mcp-launcher",
        "./scripts/mcp-proxy.mjs",
        "compose-preview",
        "mcp",
        "serve"
      ],
      "command": "sh",
      "tools": {
        "render_preview": {
          "eager": true
        },
        "simulator_open": {
          "eager": true
        }
      }
    }
  }
}
