{
  "args": [
    "../launch.mjs",
    "browse"
  ],
  "command": "node",
  "description": "Interactive Compose preview gallery, local UI Builder, and Robolectric app simulator.",
  "display_name": "Compose Preview",
  "has_web_ui": true,
  "restart_policy": "on-failure",
  "ui_config": {
    "views": [
      {
        "entrypoint": "SIDECAR_UI_ENTRYPOINT_AUX_PANE",
        "path": "/",
        "title": "Compose Preview"
      },
      {
        "entrypoint": "SIDECAR_UI_ENTRYPOINT_AUX_PANE",
        "path": "/simulator",
        "title": "Android Simulator"
      }
    ]
  }
}
