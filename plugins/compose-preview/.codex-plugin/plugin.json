{
  "author": {
    "name": "Yuri Schimke"
  },
  "description": "Render and review your Compose previews locally, and browse the hosted Material 3 and Wear catalogs and UI Builder.",
  "extensions": {
    "com.openai": {
      "onboardingSkill": "./.codex-plugin/skills/compose-preview-setup/SKILL.md"
    }
  },
  "hooks": "./hooks/codex-hooks.json",
  "interface": {
    "capabilities": [
      "Interactive"
    ],
    "category": "Developer Tools",
    "defaultPrompt": [
      "Render and review the Compose previews in this project."
    ],
    "developerName": "Yuri Schimke",
    "displayName": "Compose Preview",
    "longDescription": "Iterate on local Compose previews with live rendering, accessibility checks, catalog design guidelines and shared review evidence, with the hosted component catalogs and UI Builder alongside.",
    "shortDescription": "Render and review Compose previews."
  },
  "keywords": [
    "compose",
    "preview",
    "accessibility",
    "android",
    "design-review",
    "guidelines"
  ],
  "license": "Apache-2.0",
  "mcpServers": {
    "compose-preview-catalog": {
      "env_http_headers": {
        "X-Compose-Preview-Token": "COMPOSE_PREVIEW_TOKEN"
      },
      "type": "http",
      "url": "https://preview.coo.ee/mcp"
    },
    "compose-preview-mcp": {
      "args": [
        "mcp",
        "serve"
      ],
      "command": "compose-preview"
    }
  },
  "name": "compose-preview",
  "repository": "https://github.com/yschimke/compose-agent-plugins",
  "skills": "./.codex-plugin/skills/",
  "version": "0.12.0"
}
