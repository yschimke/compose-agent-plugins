{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Codex compatibility plugin manifest (vendored minimal contract)",
  "type": "object",
  "required": [
    "name",
    "version",
    "description",
    "author",
    "interface",
    "repository",
    "license",
    "keywords"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "author": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "interface": {
      "type": "object",
      "required": [
        "displayName",
        "shortDescription",
        "longDescription",
        "developerName",
        "category",
        "capabilities",
        "defaultPrompt"
      ],
      "properties": {
        "displayName": {
          "type": "string"
        },
        "shortDescription": {
          "type": "string"
        },
        "longDescription": {
          "type": "string"
        },
        "developerName": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "defaultPrompt": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "repository": {
      "type": "string"
    },
    "license": {
      "type": "string"
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "skills": {
      "pattern": "^\\./[a-z0-9./-]+/$"
    },
    "mcpServers": {
      "type": "object",
      "additionalProperties": {
        "type": "object"
      }
    },
    "apps": {
      "const": "./.app.json"
    },
    "hooks": {
      "const": "./hooks/codex-hooks.json"
    },
    "extensions": {
      "type": "object",
      "properties": {
        "com.openai": {
          "type": "object",
          "properties": {
            "onboardingSkill": {
              "type": "string",
              "pattern": "^\\./[a-z0-9./-]+/SKILL\\.md$"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
