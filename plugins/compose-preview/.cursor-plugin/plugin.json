{
  "agents": "./agents/",
  "author": {
    "name": "Yuri Schimke"
  },
  "category": "developer-tools",
  "description": "Render and review your Compose previews locally, and browse the hosted Material 3 and Wear catalogs and UI Builder.",
  "displayName": "Compose Preview",
  "homepage": "https://github.com/yschimke/compose-agent-plugins/tree/main/plugins/compose-preview",
  "hooks": {
    "hooks": {},
    "version": 1
  },
  "keywords": [
    "compose",
    "preview",
    "accessibility",
    "android",
    "design-review",
    "guidelines"
  ],
  "license": "Apache-2.0",
  "mcpServers": {
    "compose-preview-catalog": {
      "headers": {
        "X-Compose-Preview-Token": "${COMPOSE_PREVIEW_TOKEN}"
      },
      "type": "http",
      "url": "https://preview.coo.ee/mcp"
    },
    "compose-preview-mcp": {
      "args": [
        "mcp",
        "serve"
      ],
      "command": "compose-preview"
    }
  },
  "name": "compose-preview",
  "repository": "https://github.com/yschimke/compose-agent-plugins",
  "skills": "./skills/",
  "variables": {
    "properties": {
      "COMPOSE_PREVIEW_TOKEN": {
        "description": "Optional access token for the hosted preview.coo.ee service. Leave it blank to use the service's interactive access grant.",
        "title": "Compose Preview token",
        "type": "string"
      }
    },
    "required": [],
    "type": "object"
  },
  "version": "0.12.0"
}
